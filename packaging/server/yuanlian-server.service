[Unit]
Description=YuanLian control server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=yuanlian
Group=yuanlian
WorkingDirectory=/opt/yuanlian
EnvironmentFile=-/etc/yuanlian/server.env
Environment=YUANLIAN_BIND=127.0.0.1:18080
Environment=YUANLIAN_DB=/var/lib/yuanlian/yuanlian.db
Environment=RUST_LOG=yl_server=info,info
ExecStart=/opt/yuanlian/yl-server
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/yuanlian
StateDirectory=yuanlian
RuntimeDirectory=yuanlian
UMask=0077

[Install]
WantedBy=multi-user.target
