# YuanLian control server configuration.
# Bind loopback only; put a TLS reverse proxy in front before exposing it.
YUANLIAN_BIND=127.0.0.1:18080
YUANLIAN_DB=/var/lib/yuanlian/yuanlian.db
RUST_LOG=yl_server=info,info

# Rotate the Ed25519 ticket key once by setting this to 1 for a single start,
# then remove it. Old tickets remain verifiable until their exp; use the
# session revoke API for immediate invalidation.
# YUANLIAN_ROTATE_TICKET_KEY=1
