[Unit]
Description=YuanLian control server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/yuanlian
Environment=YUANLIAN_BIND=127.0.0.1:18080
Environment=YUANLIAN_DB=/opt/yuanlian/data/yuanlian.db
Environment=RUST_LOG=yl_server=info,info
ExecStart=/opt/yuanlian/yl-server
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/yuanlian

[Install]
WantedBy=multi-user.target
